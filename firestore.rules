rules_version = '2';

// Each student can read and write only their own documents. Only the admin account can read everyone's (never write).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The app owner's Google account can read every student's data (admin page). Read-only.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'antonyfrancis2604@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(
        ['onboarded', 'subjects', 'planStart', 'firstReadTarget', 'revisionTarget', 'rewards', 'theme', 'updatedAt',
         'name', 'email', 'createdAt']);
    }

    match /progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(
        ['chapters', 'badges', 'days', 'updatedAt']);
    }

    // Each student's study-plan answers (plan form). Admin can read them.
    match /plans/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // App version info for the "new version available" banner. Edit it from the Firebase console only.
    match /config/app {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
